# Giá trị Linear cho repo này — copy thành .cursor/loop.env rồi điền.
# Dùng bởi: scripts/sync-loop.sh / sync-loop.ps1 (hoặc sync-loop-remote.{sh,ps1} từ loop.md trên GitHub)

REPLACE_LINEAR_OWNER_DISPLAY_NAME=your-display-name
REPLACE_LINEAR_WORKSPACE=your-workspace
REPLACE_LINEAR_PROJECT_NAME=Your Project
REPLACE_LINEAR_PROJECT_URL=https://linear.app/your-workspace/project/your-project-id/overview
REPLACE_LINEAR_PROJECT_ID=your-project-id

# true: agent auto-merge PR sau ce-plan / ce-work / ce-compound (mặc định)
# false: chỉ tạo PR và gắn URL Linear, chờ owner merge tay
REPLACE_LOOP_FORCE_MERGE_PR=true
