{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Komodoro",
  "version": "0.1.0",
  "identifier": "app.komodoro.desktop",
  "build": {
    "beforeDevCommand": "sh scripts/ui.sh serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "sh scripts/ui.sh build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Komodoro",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
